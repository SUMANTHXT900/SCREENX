{
  "manifest_version": 3,
  "name": "ScreenX",
  "version": "0.1.22",
  "description": "Premium screenshot capture — visible, full-page, and area — with editor, workspace, and history.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ScreenX",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "capture-visible": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Capture visible area"
    },
    "capture-fullpage": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "Capture full page"
    },
    "capture-selected-area": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "Capture selected area"
    }
  },
  "permissions": ["activeTab", "storage", "scripting", "clipboardWrite", "downloads", "notifications"],
  "web_accessible_resources": [
    {
      "resources": ["editor.html", "workspace.html", "history.html", "assets/*", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
