{
  "name": "screenx",
  "private": true,
  "version": "0.1.0",
  "description": "ScreenX — premium screenshot capture and editor for Chrome",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc -b && vite build",
